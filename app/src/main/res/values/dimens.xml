<?xml version="1.0" encoding="utf-8"?>
<!--
    默认尺寸定义 - 手机设备
    适配minSdk 24 (Android 7.0) 到 targetSdk 35 (Android 15)
-->
<resources>
    <!-- 屏幕边距 -->
    <dimen name="screen_horizontal_margin">16dp</dimen>
    <dimen name="screen_vertical_margin">16dp</dimen>
    
    <!-- 卡片样式 -->
    <dimen name="card_padding">16dp</dimen>
    <dimen name="card_corner_radius">16dp</dimen>
    <dimen name="card_elevation">4dp</dimen>
    
    <!-- 文字尺寸 - 遵循Material3类型规范 -->
    <dimen name="text_size_title_large">28sp</dimen>
    <dimen name="text_size_title_medium">22sp</dimen>
    <dimen name="text_size_body_large">16sp</dimen>
    <dimen name="text_size_body_medium">14sp</dimen>
    <dimen name="text_size_label">12sp</dimen>
    
    <!-- 间距系统 -->
    <dimen name="spacing_xlarge">32dp</dimen>
    <dimen name="spacing_large">24dp</dimen>
    <dimen name="spacing_medium">16dp</dimen>
    <dimen name="spacing_small">8dp</dimen>
    
    <!-- 组件尺寸 -->
    <dimen name="button_height">48dp</dimen>
    <dimen name="icon_size_large">56dp</dimen>
    <dimen name="icon_size_medium">40dp</dimen>
    <dimen name="status_indicator_size">16dp</dimen>
    
    <!-- 数据卡片网格 - 手机单列显示 -->
    <integer name="data_card_span_count">1</integer>
</resources>
