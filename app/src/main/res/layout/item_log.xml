<?xml version="1.0" encoding="utf-8"?>
<!-- 日志/告警列表项布局 -->
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <!-- 告警类型图标 -->
        <ImageView
            android:id="@+id/ivLogIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_warning"
            app:tint="@color/status_warning" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <!-- 告警标题 -->
            <TextView
                android:id="@+id/tvLogTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="温度异常"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <!-- 告警详情 -->
            <TextView
                android:id="@+id/tvLogDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="当前温度: 35.2°C，超过高温阈值"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />

            <!-- 时间 -->
            <TextView
                android:id="@+id/tvLogTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="2024-01-15 14:30:25"
                android:textSize="11sp"
                android:textColor="@color/md_theme_outline" />
        </LinearLayout>

        <!-- 状态指示 -->
        <View
            android:id="@+id/viewLogStatus"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/circle_status_indicator"
            android:backgroundTint="@color/status_warning" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
