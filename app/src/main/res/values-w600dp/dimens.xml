<?xml version="1.0" encoding="utf-8"?>
<!--
    大屏幕设备适配 (平板、折叠屏)
    最小宽度600dp以上的设备使用这些尺寸
    API 32+ (Android 12L) 大屏幕优化
-->
<resources>
    <!-- 大屏幕主边距 -->
    <dimen name="screen_horizontal_margin">48dp</dimen>
    <dimen name="screen_vertical_margin">32dp</dimen>
    
    <!-- 大屏幕卡片尺寸 -->
    <dimen name="card_padding">24dp</dimen>
    <dimen name="card_corner_radius">20dp</dimen>
    <dimen name="card_elevation">8dp</dimen>
    
    <!-- 大屏幕文字尺寸 -->
    <dimen name="text_size_title_large">32sp</dimen>
    <dimen name="text_size_title_medium">24sp</dimen>
    <dimen name="text_size_body_large">18sp</dimen>
    <dimen name="text_size_body_medium">16sp</dimen>
    <dimen name="text_size_label">14sp</dimen>
    
    <!-- 大屏幕间距 -->
    <dimen name="spacing_xlarge">48dp</dimen>
    <dimen name="spacing_large">32dp</dimen>
    <dimen name="spacing_medium">20dp</dimen>
    <dimen name="spacing_small">12dp</dimen>
    
    <!-- 大屏幕组件尺寸 -->
    <dimen name="button_height">56dp</dimen>
    <dimen name="icon_size_large">72dp</dimen>
    <dimen name="icon_size_medium">48dp</dimen>
    <dimen name="status_indicator_size">20dp</dimen>
    
    <!-- 数据卡片网格布局 - 平板使用两列 -->
    <integer name="data_card_span_count">2</integer>
</resources>
